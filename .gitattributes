* text=auto
*.php diff=php
*.md text
*.js text
*.css text
*.json text
*.yml text

# Compiled assets are committed but should not clutter diffs or language stats
/dist/** linguist-generated -diff

# Exclude development files from Composer dist archives
/.github export-ignore
/art export-ignore
/docker export-ignore
/resources/css export-ignore
/resources/js export-ignore
/tests export-ignore
/.dockerignore export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/CONTRIBUTING.md export-ignore
/docker-compose.yml export-ignore
/Dockerfile export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/phpstan.neon export-ignore
/phpunit.xml export-ignore
/pint.json export-ignore
/vite.config.js export-ignore
